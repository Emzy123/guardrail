# Network: mainnet (177) by default
RPC_URL=https://mainnet.hsk.xyz
CHAIN_ID=177
# Deployed AgentVault address
VAULT_ADDRESS=0x...
# Agent wallet private key (the AGENT you passed at deploy; NOT the owner key)
AGENT_PRIVATE_KEY=0x...
# paper = simulate only, live = send real trades through the vault
MODE=paper
# Optional: any OpenAI-compatible LLM for the chat interface (falls back to a rule parser)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
PORT=8787
